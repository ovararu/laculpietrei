<% content_for :title, "Billing — #{@period_start.strftime('%B %Y')}" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Billing Summary</h1>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5"><%= @period_start.strftime("%B %Y") %></p>
  </div>

  <%# Month navigation %>
  <%= form_with url: billing_path, method: :get, class: "flex items-center gap-2" do |f| %>
    <%= f.select :month,
      (1..12).map { |m| [Date::MONTHNAMES[m], m] },
      { selected: @month },
      class: "rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    <%= f.select :year,
      (Date.today.year - 2..Date.today.year + 1).map { |y| [y, y] },
      { selected: @year },
      class: "rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    <%= f.submit "View", class: "bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 text-sm font-medium px-4 py-2 rounded-lg cursor-pointer transition-colors border-0" %>
  <% end %>
</div>

<%# Summary card %>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 px-5 py-4">
    <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Interventions</p>
    <p class="text-3xl font-bold text-gray-900 dark:text-gray-100 mt-1"><%= @interventions.count %></p>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 px-5 py-4">
    <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Total Hours</p>
    <% total_h = @total_minutes / 60; total_m = @total_minutes % 60 %>
    <p class="text-3xl font-bold text-gray-900 dark:text-gray-100 mt-1">
      <%= total_h %><span class="text-lg font-medium text-gray-500 dark:text-gray-400">h</span>
      <% if total_m > 0 %>
        <%= total_m %><span class="text-lg font-medium text-gray-500 dark:text-gray-400">min</span>
      <% end %>
    </p>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 px-5 py-4">
    <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Devices Serviced</p>
    <p class="text-3xl font-bold text-gray-900 dark:text-gray-100 mt-1"><%= @by_device.count %></p>
  </div>
</div>

<% if @by_device.any? %>
  <div class="space-y-4">
    <% @by_device.each do |device, data| %>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-100 dark:border-gray-700 flex items-center justify-between">
          <div>
            <span class="text-xs text-gray-500 dark:text-gray-400"><%= device.type_label %></span>
            <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">
              <%= link_to device.name, device, class: "hover:text-blue-600 dark:hover:text-blue-400" %>
            </h2>
          </div>
          <% dh = data[:total_minutes] / 60; dm = data[:total_minutes] % 60 %>
          <div class="text-right">
            <p class="text-sm font-bold text-gray-900 dark:text-gray-100">
              <% if dh > 0 %>
                <%= dh %>h<% if dm > 0 %> <%= dm %>min<% end %>
              <% elsif dm > 0 %>
                <%= dm %>min
              <% else %>
                —
              <% end %>
            </p>
            <p class="text-xs text-gray-400 dark:text-gray-500"><%= pluralize(data[:interventions].count, "intervention") %></p>
          </div>
        </div>
        <table class="min-w-full divide-y divide-gray-100 dark:divide-gray-700">
          <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
            <% data[:interventions].each do |i| %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td class="px-5 py-2.5 text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap w-28">
                  <%= i.intervened_at.strftime("%d %b %Y") %>
                </td>
                <td class="px-5 py-2.5">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= i.type_color %>">
                    <%= i.type_label %>
                  </span>
                </td>
                <td class="px-5 py-2.5 text-sm text-gray-700 dark:text-gray-300">
                  <%= link_to truncate(i.description, length: 70), i, class: "hover:text-blue-600 dark:hover:text-blue-400" %>
                </td>
                <td class="px-5 py-2.5 text-sm text-gray-500 dark:text-gray-400 text-right whitespace-nowrap font-medium">
                  <%= i.duration_formatted || "—" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-16 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
    <p class="text-gray-400 dark:text-gray-500 text-sm">No interventions recorded for <%= @period_start.strftime("%B %Y") %>.</p>
    <%= link_to "View all interventions", interventions_path, class: "mt-2 inline-block text-blue-600 dark:text-blue-400 text-sm hover:underline" %>
  </div>
<% end %>
