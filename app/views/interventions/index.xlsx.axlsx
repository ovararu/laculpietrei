wb = xlsx_package.workbook

date_format = "DD/MM/YYYY"

header_style = wb.styles.add_style(
  bg_color: "1D4ED8",
  fg_color: "FFFFFF",
  b: true,
  sz: 11,
  alignment: { horizontal: :center, vertical: :center, wrap_text: true },
  border: { style: :thin, color: "BFDBFE" }
)

cell_style = wb.styles.add_style(
  sz: 10,
  alignment: { vertical: :center, wrap_text: true },
  border: { style: :thin, color: "E5E7EB" }
)

cell_date_style = wb.styles.add_style(
  sz: 10,
  format_code: date_format,
  alignment: { vertical: :center },
  border: { style: :thin, color: "E5E7EB" }
)

cell_center_style = wb.styles.add_style(
  sz: 10,
  alignment: { horizontal: :center, vertical: :center },
  border: { style: :thin, color: "E5E7EB" }
)

alt_cell_style = wb.styles.add_style(
  bg_color: "F9FAFB",
  sz: 10,
  alignment: { vertical: :center, wrap_text: true },
  border: { style: :thin, color: "E5E7EB" }
)

alt_cell_date_style = wb.styles.add_style(
  bg_color: "F9FAFB",
  sz: 10,
  format_code: date_format,
  alignment: { vertical: :center },
  border: { style: :thin, color: "E5E7EB" }
)

alt_cell_center_style = wb.styles.add_style(
  bg_color: "F9FAFB",
  sz: 10,
  alignment: { horizontal: :center, vertical: :center },
  border: { style: :thin, color: "E5E7EB" }
)

type_styles = {
  "breakdown"     => wb.styles.add_style(fg_color: "B91C1C", bg_color: "FEE2E2", sz: 10, alignment: { horizontal: :center, vertical: :center }, border: { style: :thin, color: "E5E7EB" }),
  "maintenance"   => wb.styles.add_style(fg_color: "1D4ED8", bg_color: "DBEAFE", sz: 10, alignment: { horizontal: :center, vertical: :center }, border: { style: :thin, color: "E5E7EB" }),
  "installation"  => wb.styles.add_style(fg_color: "166534", bg_color: "DCFCE7", sz: 10, alignment: { horizontal: :center, vertical: :center }, border: { style: :thin, color: "E5E7EB" }),
  "configuration" => wb.styles.add_style(fg_color: "6B21A8", bg_color: "F3E8FF", sz: 10, alignment: { horizontal: :center, vertical: :center }, border: { style: :thin, color: "E5E7EB" }),
  "upgrade"       => wb.styles.add_style(fg_color: "92400E", bg_color: "FEF3C7", sz: 10, alignment: { horizontal: :center, vertical: :center }, border: { style: :thin, color: "E5E7EB" })
}

sheet_name = @device ? @device.name.truncate(31) : "Interventions"

wb.add_worksheet(name: sheet_name) do |sheet|
  headers = [ "Date", "Device", "Type", "Description", "Parts Replaced", "Duration" ]
  headers.delete("Device") if @device

  sheet.add_row(headers, style: header_style, height: 20)

  @interventions.each_with_index do |i, index|
    base_style        = index.even? ? cell_style        : alt_cell_style
    base_date_style   = index.even? ? cell_date_style   : alt_cell_date_style
    base_center_style = index.even? ? cell_center_style : alt_cell_center_style

    type_style = type_styles.fetch(i.intervention_type, base_center_style)

    if @device
      sheet.add_row(
        [
          i.intervened_at,
          i.type_label,
          i.description,
          i.parts_replaced,
          i.duration_formatted
        ],
        style:  [ base_date_style, type_style, base_style, base_style, base_center_style ],
        height: 16,
        types:  [ :date, :string, :string, :string, :string ]
      )
    else
      sheet.add_row(
        [
          i.intervened_at,
          i.device.name,
          i.type_label,
          i.description,
          i.parts_replaced,
          i.duration_formatted
        ],
        style:  [ base_date_style, base_style, type_style, base_style, base_style, base_center_style ],
        height: 16,
        types:  [ :date, :string, :string, :string, :string, :string ]
      )
    end
  end

  if @device
    sheet.column_widths 14, 22, 50, 30, 14
  else
    sheet.column_widths 14, 24, 22, 50, 30, 14
  end
end
