<% title = @device ? "Interventions — #{@device.name}" : "Interventions" %>
<% content_for :title, title %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= title %></h1>
    <% if @device %>
      <%= link_to "← Back to #{@device.name}", @device, class: "text-sm text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 mt-1 inline-block" %>
    <% end %>
  </div>
  <div class="flex items-center gap-2">
    <% export_params = @device ? { device_id: @device.id } : {} %>
    <%= link_to "Export Excel", interventions_path(export_params.merge(format: :xlsx)),
      class: "bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors" %>
    <% if @device %>
      <%= link_to "Add Intervention", new_device_intervention_path(@device), class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors" %>
    <% else %>
      <%= link_to "Add Intervention", new_intervention_path, class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors" %>
    <% end %>
  </div>
</div>

<%# Device filter — only on global page %>
<% unless @device %>
  <div class="mb-5">
    <%= form_with url: interventions_path, method: :get, class: "flex items-center gap-3" do |f| %>
      <%= f.select :device_id,
        Device.order(:name).map { |d| ["#{d.type_label} — #{d.name}", d.id] },
        { include_blank: "All devices", selected: params[:device_id] },
        class: "rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      <%= f.submit "Filter", class: "bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 text-sm font-medium px-4 py-2 rounded-lg cursor-pointer transition-colors border-0" %>
      <% if params[:device_id].present? %>
        <%= link_to "Clear", interventions_path, class: "text-sm text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400" %>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if @interventions.any? %>
  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
      <thead class="bg-gray-50 dark:bg-gray-700/50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Date</th>
          <% unless @device %>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Device</th>
          <% end %>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Type</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Description</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Parts Replaced</th>
          <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Duration</th>
          <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-100 dark:divide-gray-700">
        <% @interventions.each do |i| %>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
            <td class="px-4 py-3 text-sm text-gray-900 dark:text-gray-100 whitespace-nowrap">
              <%= link_to i.intervened_at.strftime("%d %b %Y"), i, class: "hover:text-blue-600 dark:hover:text-blue-400 font-medium" %>
            </td>
            <% unless @device %>
              <td class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400">
                <%= link_to i.device.name, i.device, class: "hover:text-blue-600 dark:hover:text-blue-400" %>
              </td>
            <% end %>
            <td class="px-4 py-3">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= i.type_color %>">
                <%= i.type_label %>
              </span>
            </td>
            <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300 max-w-xs">
              <%= truncate(i.description, length: 80) %>
            </td>
            <td class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400 max-w-xs">
              <%= truncate(i.parts_replaced, length: 50) %>
            </td>
            <td class="px-4 py-3 text-right text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">
              <%= i.duration_formatted || "—" %>
            </td>
            <td class="px-4 py-3 text-right text-sm space-x-2 whitespace-nowrap">
              <%= link_to "Edit", edit_intervention_path(i), class: "text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400" %>
              <%= button_to "Delete", intervention_path(i), method: :delete,
                class: "text-gray-500 dark:text-gray-400 hover:text-red-600 dark:hover:text-red-400 bg-transparent border-0 cursor-pointer p-0",
                data: { turbo_confirm: "Delete this intervention?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="text-center py-16 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
    <p class="text-gray-400 dark:text-gray-500 text-sm">No interventions recorded yet.</p>
    <%= link_to "Record the first intervention",
      (@device ? new_device_intervention_path(@device) : new_intervention_path),
      class: "mt-2 inline-block text-blue-600 dark:text-blue-400 text-sm hover:underline" %>
  </div>
<% end %>
