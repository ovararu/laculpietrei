<%= form_with model: intervention_form_model(intervention, device), class: "space-y-5" do |f| %>
  <% if intervention.errors.any? %>
    <div class="bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-700 rounded-lg px-4 py-3">
      <p class="text-sm font-medium text-red-700 dark:text-red-400 mb-1"><%= pluralize(intervention.errors.count, "error") %> prevented this record from being saved:</p>
      <ul class="list-disc list-inside text-sm text-red-600 dark:text-red-400 space-y-0.5">
        <% intervention.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div>
      <%= f.label :device_id, "Device", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <% if device %>
        <div class="block w-full rounded-lg border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700/50 text-gray-700 dark:text-gray-300 px-3 py-2 text-sm">
          <%= device.type_label %> — <%= device.name %>
        </div>
        <%= f.hidden_field :device_id, value: device.id %>
      <% else %>
        <%= f.select :device_id,
          Device.order(:name).map { |d| ["#{d.type_label} — #{d.name}", d.id] },
          { include_blank: "Select device..." },
          class: "block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      <% end %>
    </div>

    <div>
      <%= f.label :intervened_at, "Date", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.date_field :intervened_at, class: "block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :intervention_type, "Type", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.select :intervention_type,
        Intervention::TYPES.map { |t| [Intervention::TYPE_LABELS[t], t] },
        { include_blank: "Select type..." },
        class: "block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :duration_minutes, "Duration (minutes)", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.number_field :duration_minutes, min: 0, step: 15, placeholder: "e.g. 90",
        class: "block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">Used for end-of-month billing summary</p>
    </div>
  </div>

  <div>
    <%= f.label :description, "Description / Work Done", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.text_area :description, rows: 4, class: "block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "Describe the work performed..." %>
  </div>

  <div>
    <%= f.label :parts_replaced, "Parts Replaced", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.text_area :parts_replaced, rows: 2, class: "block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "List any replaced components (optional)..." %>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-5 py-2 rounded-lg transition-colors cursor-pointer" %>
    <%= link_to "Cancel", (device ? device_path(device) : interventions_path), class: "text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 px-3 py-2" %>
  </div>
<% end %>
