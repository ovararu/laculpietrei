<% content_for :title, "Network Topology" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Network Topology</h1>
  <div class="flex items-center gap-2">
    <button id="topology-fit"
      class="text-sm text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 px-3 py-1.5 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors">
      Fit to screen
    </button>
    <button id="topology-physics"
      class="text-sm text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 px-3 py-1.5 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors">
      Toggle physics
    </button>
  </div>
</div>

<%# Canvas %>
<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden mb-4"
     data-controller="topology"
     data-topology-url-value="<%= topology_graph_data_path %>"
     data-topology-dark-value="<%= false %>">
  <div data-topology-target="canvas" style="height: 580px;"></div>
</div>

<%# Legend %>
<div class="flex flex-wrap gap-4 items-center bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 px-5 py-4">
  <span class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mr-2">Legend:</span>
  <% [["Camera", "#3B82F6", "dot"], ["Switch", "#8B5CF6", "hexagon"], ["Router", "#10B981", "diamond"], ["PC", "#F59E0B", "square"], ["Server", "#EF4444", "box"]].each do |label, color, _shape| %>
    <span class="flex items-center gap-1.5 text-xs text-gray-600 dark:text-gray-300">
      <span class="inline-block w-3 h-3 rounded-full" style="background-color: <%= color %>;"></span>
      <%= label %>
    </span>
  <% end %>
  <span class="ml-4 text-xs text-gray-400 dark:text-gray-500">Dashed border = inactive &nbsp;|&nbsp; Yellow border = maintenance</span>
</div>

<% if Device.where(parent_device_id: nil).count == Device.count %>
  <div class="mt-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-700 rounded-lg px-4 py-3 text-sm text-blue-700 dark:text-blue-300">
    No connections defined yet. Edit devices and assign a <strong>Parent Device</strong> to build the topology.
  </div>
<% end %>
