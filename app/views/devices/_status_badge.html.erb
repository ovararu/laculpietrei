<% colors = { "active" => "bg-green-100 text-green-700", "inactive" => "bg-red-100 text-red-700", "maintenance" => "bg-yellow-100 text-yellow-700" } %>
<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= colors.fetch(status, 'bg-gray-100 text-gray-600') %>">
  <%= status&.capitalize %>
</span>
