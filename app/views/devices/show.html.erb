<% content_for :title, @device.name %>

<div class="max-w-2xl">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← Back to devices", devices_path, class: "text-sm text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400" %>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
    <div class="px-6 py-5 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
      <div>
        <h1 class="text-xl font-bold text-gray-900 dark:text-gray-100"><%= @device.name %></h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5"><%= @device.type_label %></p>
      </div>
      <%= render "status_badge", status: @device.status %>
    </div>

    <dl class="divide-y divide-gray-100 dark:divide-gray-700">
      <% {
        "Brand" => @device.brand,
        "Model" => @device.model_number,
        "Serial Number" => @device.serial_number,
        "IP Address" => @device.ip_address,
        "MAC Address" => @device.mac_address,
        "Username" => @device.username,
        "Password" => @device.password,
        "Location" => @device.location,
        "Purchased" => (@device.purchased_at&.strftime("%d %b %Y")),
        "Warranty Expires" => (@device.warranty_expires_at&.strftime("%d %b %Y")),
      }.each do |label, value| %>
        <% next if value.blank? %>
        <div class="px-6 py-3 flex">
          <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 w-40 shrink-0"><%= label %></dt>
          <dd class="text-sm text-gray-900 dark:text-gray-100 font-mono"><%= value %></dd>
        </div>
      <% end %>

      <% if @device.notes.present? %>
        <div class="px-6 py-3">
          <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Notes</dt>
          <dd class="text-sm text-gray-900 dark:text-gray-100 whitespace-pre-wrap"><%= @device.notes %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="flex gap-3 mt-4">
    <%= link_to "Edit", edit_device_path(@device), class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors" %>
    <%= button_to "Delete", device_path(@device), method: :delete,
      class: "bg-red-50 dark:bg-red-900/30 hover:bg-red-100 dark:hover:bg-red-900/50 text-red-600 dark:text-red-400 text-sm font-medium px-4 py-2 rounded-lg transition-colors border-0 cursor-pointer",
      data: { turbo_confirm: "Delete #{@device.name}?" } %>
  </div>

  <%# Interventions section %>
  <% interventions = @device.interventions.limit(5) %>
  <div class="mt-8">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100">
        Interventions
        <% if @device.interventions.count > 0 %>
          <span class="ml-1.5 text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 px-2 py-0.5 rounded-full"><%= @device.interventions.count %></span>
        <% end %>
      </h2>
      <div class="flex items-center gap-2">
        <%= link_to "Add Intervention", new_device_intervention_path(@device), class: "bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium px-3 py-1.5 rounded-lg transition-colors" %>
      </div>
    </div>

    <% if interventions.any? %>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 divide-y divide-gray-100 dark:divide-gray-700 overflow-hidden">
        <% interventions.each do |i| %>
          <div class="px-4 py-3 flex items-start gap-3 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
            <span class="mt-0.5 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium shrink-0 <%= i.type_color %>">
              <%= i.type_label %>
            </span>
            <div class="flex-1 min-w-0">
              <p class="text-sm text-gray-900 dark:text-gray-100 truncate"><%= i.description %></p>
              <% if i.parts_replaced.present? %>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5 truncate">Parts: <%= i.parts_replaced %></p>
              <% end %>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <% if i.duration_formatted %>
                <span class="text-xs text-gray-500 dark:text-gray-400 font-medium"><%= i.duration_formatted %></span>
              <% end %>
              <span class="text-xs text-gray-400 dark:text-gray-500 whitespace-nowrap"><%= i.intervened_at.strftime("%d %b %Y") %></span>
              <%= link_to "View", i, class: "text-xs text-blue-600 dark:text-blue-400 hover:underline" %>
            </div>
          </div>
        <% end %>
      </div>
      <% if @device.interventions.count > 5 %>
        <div class="mt-2 text-right">
          <%= link_to "View all #{@device.interventions.count} interventions →", interventions_path(device_id: @device.id), class: "text-sm text-blue-600 dark:text-blue-400 hover:underline" %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-8 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
        <p class="text-gray-400 dark:text-gray-500 text-sm">No interventions recorded for this device.</p>
        <%= link_to "Record first intervention", new_device_intervention_path(@device), class: "mt-1 inline-block text-blue-600 dark:text-blue-400 text-sm hover:underline" %>
      </div>
    <% end %>
  </div>
</div>
