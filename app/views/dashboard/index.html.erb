<% content_for :title, "Dashboard" %>

<div class="mb-6">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Dashboard</h1>
</div>

<%# Stat cards %>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 px-5 py-4">
    <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Total Devices</p>
    <p class="text-3xl font-bold text-gray-900 dark:text-gray-100"><%= @total %></p>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 px-5 py-4">
    <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Active</p>
    <p class="text-3xl font-bold text-green-600 dark:text-green-400"><%= @active %></p>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 px-5 py-4">
    <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Inactive / Maintenance</p>
    <p class="text-3xl font-bold text-red-500 dark:text-red-400"><%= @inactive + @maintenance %></p>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 px-5 py-4">
    <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Warranty Expiring (90d)</p>
    <p class="text-3xl font-bold text-yellow-500 dark:text-yellow-400"><%= @warranty_expiring.count %></p>
  </div>
</div>

<%# Charts %>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8"
     data-controller="chart"
     data-chart-type-value="<%= @by_type.to_json %>"
     data-chart-status-value="<%= @by_status.to_json %>">

  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 px-5 py-5">
    <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4">Devices by Type</h2>
    <div class="flex justify-center">
      <canvas data-chart-target="typeCanvas" width="260" height="260"></canvas>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 px-5 py-5">
    <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4">Devices by Status</h2>
    <canvas data-chart-target="statusCanvas"></canvas>
  </div>
</div>

<%# Warranty expiring table %>
<% if @warranty_expiring.any? %>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-yellow-200 dark:border-yellow-700 overflow-hidden">
    <div class="px-5 py-4 border-b border-yellow-200 dark:border-yellow-700 bg-yellow-50 dark:bg-yellow-900/20">
      <h2 class="text-sm font-semibold text-yellow-800 dark:text-yellow-300">Warranty Expiring in 90 Days</h2>
    </div>
    <table class="min-w-full divide-y divide-gray-100 dark:divide-gray-700">
      <thead class="bg-gray-50 dark:bg-gray-700/50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Name</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Type</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Location</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Warranty Expires</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
        <% @warranty_expiring.each do |device| %>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
            <td class="px-4 py-3 text-sm font-medium text-gray-900 dark:text-gray-100">
              <%= link_to device.name, device, class: "hover:text-blue-600 dark:hover:text-blue-400" %>
            </td>
            <td class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400"><%= device.type_label %></td>
            <td class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400"><%= device.location %></td>
            <td class="px-4 py-3 text-sm font-medium text-yellow-700 dark:text-yellow-400">
              <%= device.warranty_expires_at.strftime("%d %b %Y") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
